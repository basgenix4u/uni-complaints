# Copy to .env and fill in. Never commit .env.

FLASK_ENV=development
FLASK_DEBUG=True
PORT=5000

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me
JWT_SECRET_KEY=change-me-too

# SQLite for local development; PostgreSQL in production.
DATABASE_URL=sqlite:///resolve.db
# DATABASE_URL=postgresql://user:password@localhost:5432/resolve

JWT_ACCESS_TOKEN_MINUTES=30
JWT_REFRESH_TOKEN_DAYS=30

CORS_ORIGINS=http://localhost:5173

RATELIMIT_STORAGE_URI=memory://

# Platform owner account created by `flask seed`.
PLATFORM_ADMIN_EMAIL=admin@resolve.ng
PLATFORM_ADMIN_PASSWORD=ChangeMe123
