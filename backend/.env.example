# Copy to .env and fill in. Never commit .env.

FLASK_ENV=development
FLASK_DEBUG=True
PORT=5000

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me
JWT_SECRET_KEY=change-me-too

# SQLite for local development; PostgreSQL in production.
DATABASE_URL=sqlite:///resolve.db
# Supabase: use the SESSION POOLER string, not the direct connection.
# The direct connection is IPv6 only on the free plan, and most hosts are
# IPv4, so it will not connect.
# DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Sharing a database with another application. Set this and every table,
# index and foreign key is created in a PostgreSQL schema of its own,
# including the Alembic version table, so common names such as users or
# notifications cannot collide. Leave empty for a database of your own.
# Ignored on SQLite, which has no schemas. See docs/SHARED-DATABASE.md.
DB_SCHEMA=

JWT_ACCESS_TOKEN_MINUTES=30
JWT_REFRESH_TOKEN_DAYS=30

CORS_ORIGINS=http://localhost:5173
# Preview deployments get a unique hostname each time and cannot be listed.
# Leave unset unless you use them.
# CORS_ORIGIN_REGEX=https://.*\.vercel\.app

RATELIMIT_STORAGE_URI=memory://

# Platform owner account created by `flask seed`.
PLATFORM_ADMIN_EMAIL=admin@resolve.ng
PLATFORM_ADMIN_PASSWORD=ChangeMe123

# File uploads. Local disk in development.
UPLOAD_DIR=uploads

# Object storage. Required on any host with an ephemeral filesystem, which
# is most of them: without it, uploads vanish on the next deploy. Pick one.
# Files are streamed by the API after the usual permission checks, so no
# storage URL ever reaches a browser.

# Cloudinary. Takes precedence when both are set. Uploads use the
# authenticated delivery type, because the default publishes assets to a
# public CDN and these are complaint attachments.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=resolve/attachments

# Supabase Storage. The bucket must be private.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=attachments

# Outbound email. Email is what confirms a student's address, and an
# account that cannot confirm cannot file a complaint, so this is not
# optional for a real deployment. See docs/EMAIL-SETUP.md.
#
# Without it, messages are HELD in the queue rather than discarded or
# failed, and send in full once a provider is configured. Meanwhile an
# administrator can confirm addresses by hand.
#
# Use a transactional provider, not a personal mailbox. Brevo gives 300
# a day free and works from Nigeria without a US entity.
# Port 587 is STARTTLS; 465 is implicit TLS. Both are handled.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# Must be a domain you control, with SPF and DKIM set, or it lands in spam.
MAIL_FROM=no-reply@resolve.ng

# Writes emails to the log instead of sending them, so local work does not
# need a mail server. Production refuses to start with this on: a
# confirmation link is a credential and logs are widely readable.
MAIL_TO_CONSOLE=false

# Where password reset, confirmation and invitation links point. Must
# match the deployed front end: every link in every email is built from
# it, so if it is wrong they all point at the wrong place.
APP_URL=http://localhost:5173

# SMS. One of: termii, africastalking, console. Empty disables texts.
# Escalations are texted, since a phone receives SMS after data runs out.
SMS_PROVIDER=
SMS_SENDER_ID=Resolve
TERMII_API_KEY=
AFRICASTALKING_API_KEY=
AFRICASTALKING_USERNAME=

# Set to false only for end to end runs against a throwaway database.
# Production refuses to start when this is disabled.
RATELIMIT_ENABLED=true

# Rate limits are counted per process. With more than one worker this must
# point at shared storage or the login limit is multiplied by the worker
# count. Production refuses to start with memory:// and WEB_CONCURRENCY
# above one.
RATELIMIT_STORAGE_URI=memory://
# RATELIMIT_STORAGE_URI=redis://localhost:6379/0

# Observability. Absent, error reporting is off and logs are human readable.
LOG_LEVEL=INFO
ENVIRONMENT=development
RELEASE=
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0

# Shared secret for the HTTP task trigger, used only where the host has no
# scheduler. Unset means the endpoint does not exist. See
# docs/DEPLOYMENT-FREE.md.
TASK_TOKEN=
